# Copia este fichero a .env.local para desarrollo. Nunca subas secretos al repositorio.

# PostgreSQL (local: docker compose up -d db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mph_dev

# URL pública de la app (en producción, la de Render con https://)
APP_URL=http://localhost:3000

# OAuth de Google (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo "Aplicación web")
# URI de redirección autorizada: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Carpeta de archivos subidos (en Render: /var/data/storage, en el disco persistente)
STORAGE_DIR=.storage

# Opcional: limita el acceso a cuentas de un dominio de Google Workspace (p. ej. ideolab.es)
AUTH_GOOGLE_HOSTED_DOMAIN=

# Emails (separados por comas) que entran como administradores la primera vez
BOOTSTRAP_ADMIN_EMAILS=

# IA (opcional). Sin estas variables la IA está desactivada en todo el servidor.
# Además hay que activarla en cada proyecto (Ajustes), con su límite de gasto mensual.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
